APP_NAME=CondoUrban API
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

SECRET_KEY=change-me-to-a-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Connection (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=condourban
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/condourban

CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
