# =============================================================================
# CondoUrban — variáveis de ambiente (EXEMPLO)
# Copie para `.env` e preencha. Nunca committe o arquivo `.env`.
# =============================================================================

# --- Geral ---
APP_NAME=CondoUrban
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1

# --- Banco (degrau A: SQLite; staging/prod: PostgreSQL) ---
# Dev local:
DATABASE_URL=sqlite:///./dev.db
# Postgres (exemplo):
# DATABASE_URL=postgresql+psycopg2://condominio:change-me-db-password@localhost:5432/condominio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=condominio
POSTGRES_USER=condominio
POSTGRES_PASSWORD=change-me-db-password

# --- Redis / filas (opcional no degrau A) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth JWT ---
JWT_SECRET=change-me-jwt-secret-different-from-secret-key
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
GOOGLE_CLIENT_ID=

# --- Front (Angular) ---
WEB_APP_URL=http://localhost:4200
WEB_MARKETING_URL=http://localhost:4300

# --- E-mail (dev: console) ---
EMAIL_BACKEND=console
EMAIL_FROM=noreply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# --- Object storage (vazio = disco local em DEV) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=condominio-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
MEDIA_ROOT=./uploads

# --- Web Push (PWA) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- Intelbras ---
INTELBRAS_ENABLED=false
INTELBRAS_BASE_URL=
INTELBRAS_API_USER=
INTELBRAS_API_PASSWORD=
INTELBRAS_TIMEOUT_SECONDS=30

# --- LGPD / políticas ---
LEGAL_REQUIRE_REACCEPT_ON_MATERIAL_CHANGE=true

# --- Observabilidade ---
SENTRY_DSN=
LOG_LEVEL=INFO
